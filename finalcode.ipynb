    "Training batches:",
    len(train_loader)
)

print(
    "Testing batches:",
    len(test_loader)
)


# ===============================================================
# 17. Hybrid Transformer Model
# ===============================================================

class HybridTransformer(nn.Module):

    def __init__(
        self,
        model_name,
        meta_dim,
        num_labels,
        freeze_base=True
    ):

        super().__init__()

        # -------------------------------------------------------
        # DistilBERT
        # -------------------------------------------------------

        self.transformer = AutoModel.from_pretrained(
            model_name
        )

        hidden_size = (
            self.transformer
            .config
            .hidden_size
        )


        # -------------------------------------------------------
        # Freeze most DistilBERT layers
        # Keep final two transformer layers trainable
        # -------------------------------------------------------

        if freeze_base:

            for name, param in (
                self.transformer
                .named_parameters()
            ):

                if (
                    "transformer.layer.4" not in name
                    and
                    "transformer.layer.5" not in name
                ):

                    param.requires_grad = False


        # -------------------------------------------------------
        # Metadata Network
        # -------------------------------------------------------

        self.meta_net = nn.Sequential(

            nn.Linear(
                meta_dim,
                32
            ),

            nn.ReLU(),

            nn.Dropout(0.2)
        )


        # -------------------------------------------------------
        # Classification Network
        # -------------------------------------------------------

        self.classifier = nn.Sequential(

            nn.Linear(
                hidden_size + 32,
                128
            ),

            nn.ReLU(),

            nn.Dropout(0.3),

            nn.Linear(
                128,
                num_labels
            )
        )


    def forward(
        self,
        input_ids,
        attention_mask,
        meta
    ):

        # Transformer output

        outputs = self.transformer(
            input_ids=input_ids,
            attention_mask=attention_mask
        )


        # CLS representation

        text_feat = (
            outputs
            .last_hidden_state[:, 0, :]
        )


        # Metadata representation

        meta_feat = self.meta_net(meta)


        # Combine text + metadata

        combined = torch.cat(
            (
                text_feat,
                meta_feat
            ),
            dim=1
        )


        # Classification

        return self.classifier(
            combined
        )


# ===============================================================
# 18. Create Model
# ===============================================================

model = HybridTransformer(
    model_name=MODEL_NAME,

    meta_dim=len(meta_cols),

    num_labels=len(le.classes_),

    freeze_base=True
).to(DEVICE)


print("\nModel created successfully.")


# ===============================================================
# 19. Count Parameters
# ===============================================================

total_params = sum(
    p.numel()
    for p in model.parameters()
)

trainable_params = sum(
    p.numel()
    for p in model.parameters()
    if p.requires_grad
)

print(
    f"Total parameters: "
    f"{total_params:,}"
)

print(
    f"Trainable parameters: "
    f"{trainable_params:,}"
)


# ===============================================================
# 20. Optimizer and Loss
# ===============================================================

optimizer = AdamW(
    filter(
        lambda p: p.requires_grad,
        model.parameters()
    ),
    lr=LEARNING_RATE
)

criterion = nn.CrossEntropyLoss()


# ===============================================================
# 21. Mixed Precision Setup
# ===============================================================
# New PyTorch API.
# This replaces deprecated torch.cuda.amp usage.

USE_AMP = DEVICE.type == "cuda"

if USE_AMP:

    amp_scaler = torch.amp.GradScaler(
        "cuda"
    )

else:

    amp_scaler = None


# ===============================================================
# 22. Training History
# ===============================================================

train_losses = []

train_accuracies = []


# ===============================================================
# 23. Training Loop
# ===============================================================

print("\n==============================================")
print("Starting Training")
print("==============================================")


for epoch in range(EPOCHS):

    model.train()

    total_loss = 0.0

    correct = 0

    total = 0


    progress_bar = tqdm(
        train_loader,
        desc=f"Epoch {epoch + 1}/{EPOCHS}"
    )


    for batch in progress_bar:

        # -------------------------------------------------------
        # Move data to device
        # -------------------------------------------------------

        input_ids = batch[
            "input_ids"
        ].to(
            DEVICE,
            non_blocking=True
        )

        attention_mask = batch[
            "attention_mask"
        ].to(
            DEVICE,
            non_blocking=True
        )

        meta = batch[
            "meta"
        ].to(
            DEVICE,
            non_blocking=True
        )

        labels = batch[
            "label"
        ].to(
            DEVICE,
            non_blocking=True
        )


        # -------------------------------------------------------
        # Reset gradients
        # -------------------------------------------------------

        optimizer.zero_grad(
            set_to_none=True
        )


        # -------------------------------------------------------
        # Forward + Loss
        # -------------------------------------------------------

        if USE_AMP:

            with torch.amp.autocast(
                device_type="cuda"
            ):

                outputs = model(
                    input_ids,
                    attention_mask,
                    meta
                )

                loss = criterion(
                    outputs,
                    labels
                )


            # ---------------------------------------------------
            # Backpropagation with AMP
            # ---------------------------------------------------

            amp_scaler.scale(
                loss
            ).backward()

            amp_scaler.step(
                optimizer
            )

            amp_scaler.update()


        else:

            outputs = model(
                input_ids,
                attention_mask,
                meta
            )

            loss = criterion(
                outputs,
                labels
            )

            loss.backward()

            optimizer.step()


        # -------------------------------------------------------
        # Statistics
        # -------------------------------------------------------

        total_loss += loss.item()

        predictions = (
            outputs
            .argmax(dim=1)
        )

        correct += (
            predictions == labels
        ).sum().item()

        total += labels.size(0)


        progress_bar.set_postfix(
            loss=f"{loss.item():.4f}"
        )


    # -----------------------------------------------------------
    # Epoch statistics
    # -----------------------------------------------------------

    epoch_loss = (
        total_loss /
        len(train_loader)
    )

    epoch_accuracy = (
        correct /
        total
    )


    train_losses.append(
        epoch_loss
    )

    train_accuracies.append(
        epoch_accuracy
    )


    print(
        f"\nEpoch {epoch + 1}/{EPOCHS}"
    )

    print(
        f"Training Loss: "
        f"{epoch_loss:.4f}"
    )

    print(
        f"Training Accuracy: "
        f"{epoch_accuracy:.4f}"
    )


# ===============================================================
# 24. Evaluation
# ===============================================================

print("\n==============================================")
print("Evaluating Model")
print("==============================================")


model.eval()

preds = []

trues = []


with torch.no_grad():

    for batch in tqdm(
        test_loader,
