        input_ids = batch[
            "input_ids"
        ].to(
            DEVICE,
            non_blocking=True
        )

        attention_mask = batch[
            "attention_mask"
        ].to(
            DEVICE,
            non_blocking=True
        )

        meta = batch[
            "meta"
        ].to(
            DEVICE,
            non_blocking=True
        )

        labels = batch[
            "label"
        ].to(
            DEVICE,
            non_blocking=True
        )


        # -------------------------------------------------------
        # Forward pass
        # -------------------------------------------------------

        if USE_AMP:

            with torch.amp.autocast(
                device_type="cuda"
            ):

                outputs = model(
                    input_ids,
                    attention_mask,
                    meta
                )

        else:

            outputs = model(
                input_ids,
                attention_mask,
                meta
            )


        predictions = (
            outputs
            .argmax(dim=1)
        )


        preds.extend(
            predictions
            .cpu()
            .numpy()
        )

        trues.extend(
            labels
            .cpu()
            .numpy()
        )


# ===============================================================
# 25. Evaluation Metrics
