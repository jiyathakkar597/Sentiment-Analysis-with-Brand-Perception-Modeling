# ===============================================================
# 33. Extract CLS Embeddings
# ===============================================================

def extract_cls_embeddings(
    model,
    loader,
    num_samples=1500
):

    model.eval()

    embeddings = []

    labels = []

    collected = 0


    with torch.no_grad():

        for batch in loader:

            input_ids = batch[
                "input_ids"
            ].to(
                DEVICE,
                non_blocking=True
            )

            attention_mask = batch[
                "attention_mask"
            ].to(
                DEVICE,
                non_blocking=True
            )


            # ---------------------------------------------------
            # Transformer output
            # ---------------------------------------------------

            outputs = model.transformer(
                input_ids=input_ids,
                attention_mask=attention_mask
            )


            # CLS embedding

            cls_embedding = (
                outputs
                .last_hidden_state[
                    :,
                    0,
                    :
                ]
                .cpu()
                .numpy()
            )


            embeddings.append(
                cls_embedding
            )


            labels.extend(
                batch[
                    "label"
                ].cpu().numpy()
            )


            collected += (
                cls_embedding.shape[0]
            )


            if collected >= num_samples:

                break


    embeddings = np.vstack(
        embeddings
    )[:num_samples]

    labels = np.array(
        labels
    )[:num_samples]


    return embeddings, labels


# ===============================================================
# 34. Generate Embeddings
# ===============================================================

print(
    "\nExtracting CLS embeddings..."
)

sample_loader = DataLoader(
    test_ds,

    batch_size=64,

    shuffle=False,

    num_workers=0,

    pin_memory=PIN_MEMORY
)


embs, emb_labels = (
    extract_cls_embeddings(
        model,
        sample_loader,
        num_samples=1500
    )
)


print(
    "Embedding shape:",
    embs.shape
)


# ===============================================================
# 35. PCA
# ===============================================================

# PCA components cannot exceed the number
# of samples or original feature dimensions.

n_components = min(
    50,
    embs.shape[0],
    embs.shape[1]
)


pca = PCA(
    n_components=n_components,
    random_state=SEED
)

emb_pca = pca.fit_transform(
    embs
)


print(
    "PCA shape:",
    emb_pca.shape
)


# ===============================================================
# 36. t-SNE
# ===============================================================

# Perplexity must be smaller than the number
# of samples.

perplexity = min(
    40,
    max(5, (len(emb_pca) - 1) // 3)
)


tsne = TSNE(
    n_components=2,

    perplexity=perplexity,

    random_state=SEED,

    init="pca",

    learning_rate="auto"
)


emb_tsne = tsne.fit_transform(
    emb_pca
)


# ===============================================================
# 37. t-SNE Visualization
# ===============================================================

plt.figure(
    figsize=(9, 7)
)

for i, class_name in enumerate(
    le.classes_
):

    idx = (
        emb_labels == i
    )

    plt.scatter(
        emb_tsne[idx, 0],

        emb_tsne[idx, 1],

        label=class_name,

        alpha=0.6,

        s=15
    )


plt.title(
    "t-SNE Visualization of CLS Embeddings"
)

plt.xlabel(
    "t-SNE Dimension 1"
)

plt.ylabel(
    "t-SNE Dimension 2"
)

plt.legend()

plt.tight_layout()

plt.savefig(
    os.path.join(
        OUTPUT_DIR,
        "embeddings_tsne.png"
    ),
    dpi=300,
    bbox_inches="tight"
)

plt.show()


