LEARNING_RATE = 2e-5

EPOCHS = 3

NUM_WORKERS = 0

DATA_PATH = "/kaggle/input/revies-analysis"

TRAIN_FILE = os.path.join(DATA_PATH, "training_data.xlsx")
TEST_FILE = os.path.join(DATA_PATH, "testing_data.xlsx")

OUTPUT_DIR = "./hybrid_model_outputs"

os.makedirs(OUTPUT_DIR, exist_ok=True)


# ===============================================================
# 4. Reproducibility
# ===============================================================

def set_seed(seed=42):

    random.seed(seed)
    np.random.seed(seed)

    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed(seed)
        torch.cuda.manual_seed_all(seed)

        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False


set_seed(SEED)


# ===============================================================
# 5. Device
# ===============================================================

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("==============================================")
print("Device:", DEVICE)
print("Model:", MODEL_NAME)
print("==============================================")


# ===============================================================
# 6. Load Dataset
# ===============================================================

print("\nLoading dataset...")

train_df = pd.read_excel(TRAIN_FILE)
test_df = pd.read_excel(TEST_FILE)

print("Training samples:", len(train_df))
print("Testing samples :", len(test_df))


# ===============================================================
# 7. Clean Sentiment Labels
# ===============================================================

def simplify_sentiment(label):

    label = str(label).lower()

    if "positive" in label:
        return "Positive"

    elif "negative" in label:
        return "Negative"

    elif "neutral" in label:
        return "Neutral"

    else:
        return "Neutral"


train_df["predicted_sentiments"] = (
    train_df["predicted_sentiments"]
    .apply(simplify_sentiment)
)

test_df["predicted_sentiments"] = (
    test_df["predicted_sentiments"]
    .apply(simplify_sentiment)
)


# ===============================================================
# 8. Remove Missing Values
# ===============================================================

train_df = train_df.dropna(
    subset=[
        "clean_review",
        "predicted_sentiments"
    ]
).reset_index(drop=True)

test_df = test_df.dropna(
    subset=[
        "clean_review",
        "predicted_sentiments"
    ]
).reset_index(drop=True)


print("\nAfter cleaning:")
print("Training samples:", len(train_df))
print("Testing samples :", len(test_df))


# ===============================================================
# 9. Metadata Features
# ===============================================================

meta_cols = [
    "Actuation_Score",
    "Awareness_Score",
    "Connectivity_Score",
    "Dynamism_Score",
    "Novelty_Score",
    "Personality_Score"
]


# Check that all required columns exist

missing_train_cols = [
    col for col in meta_cols
    if col not in train_df.columns
]

missing_test_cols = [
    col for col in meta_cols
    if col not in test_df.columns
]

if missing_train_cols:
    raise ValueError(
        f"Missing metadata columns in training data: "
        f"{missing_train_cols}"
    )

if missing_test_cols:
    raise ValueError(
        f"Missing metadata columns in testing data: "
        f"{missing_test_cols}"
    )


# ===============================================================
# 10. Encode Labels
# ===============================================================

le = LabelEncoder()

train_df["label"] = le.fit_transform(
    train_df["predicted_sentiments"]
)

test_df["label"] = le.transform(
    test_df["predicted_sentiments"]
)

print("\nClasses:")
print(list(le.classes_))


# ===============================================================
# 11. Scale Metadata Features
# ===============================================================

scaler = StandardScaler()

train_meta = train_df[meta_cols].fillna(0)

test_meta = test_df[meta_cols].fillna(0)

train_df[meta_cols] = scaler.fit_transform(
    train_meta
)

test_df[meta_cols] = scaler.transform(
    test_meta
)


# ===============================================================
# 12. Load Tokenizer
# ===============================================================

print("\nLoading tokenizer...")

tokenizer = AutoTokenizer.from_pretrained(
    MODEL_NAME
)


# ===============================================================
# 13. Tokenization
# ===============================================================

def tokenize_texts(df):

    return tokenizer(
        df["clean_review"].astype(str).tolist(),

        truncation=True,

        padding="max_length",

        max_length=MAX_LENGTH,

        return_tensors="pt"
    )


print("Tokenizing training data...")

train_enc = tokenize_texts(train_df)

print("Tokenizing testing data...")

test_enc = tokenize_texts(test_df)


# ===============================================================
# 14. Dataset Class
# ===============================================================

class ReviewDataset(Dataset):

    def __init__(
        self,
        encodings,
        metas,
        labels
    ):

        self.encodings = encodings

        self.metas = torch.tensor(
            metas,
            dtype=torch.float32
        )

        self.labels = torch.tensor(
            labels,
            dtype=torch.long
        )

    def __len__(self):

        return len(self.labels)

    def __getitem__(self, idx):

        return {
            "input_ids":
                self.encodings["input_ids"][idx],

            "attention_mask":
                self.encodings["attention_mask"][idx],

            "meta":
                self.metas[idx],

            "label":
                self.labels[idx]
        }


# ===============================================================
# 15. Create Datasets
# ===============================================================

train_ds = ReviewDataset(
    train_enc,
    train_df[meta_cols].values,
    train_df["label"].values
)

test_ds = ReviewDataset(
    test_enc,
    test_df[meta_cols].values,
    test_df["label"].values
)


# ===============================================================
# 16. DataLoaders
# ===============================================================
# num_workers=0 fixes the multiprocessing problem observed
# in the original Kaggle notebook.

PIN_MEMORY = torch.cuda.is_available()

train_loader = DataLoader(
    train_ds,

    batch_size=TRAIN_BATCH_SIZE,

    shuffle=True,

    num_workers=NUM_WORKERS,

    pin_memory=PIN_MEMORY
)

test_loader = DataLoader(
    test_ds,

    batch_size=TEST_BATCH_SIZE,

    shuffle=False,

    num_workers=NUM_WORKERS,

    pin_memory=PIN_MEMORY
)


print("\nDataLoaders created successfully.")

